@misc{rightclick2026,
  title        = {Right Click, Wrong Box: Grading {GUI} Grounding by What a Click Does},
  author       = {Yuan, Xiaokang and Yao, Binhui and Yang, Luwei and Chen, Ruimin and Wang, Zeng},
  year         = {2026},
  eprint       = {2610.36831},
  archivePrefix= {arXiv},
  primaryClass = {cs.CV},
  howpublished = {\url{https://arxiv.org/abs/2610.36831}},
  note         = {Submitted 27 Oct 2026. Outcome-equivalent click metric via execution probes. On a code forge and an online shop, about 1/5 and 1/3 of box-rejected clicks reach the intended outcome; on web ScreenSpot-v2 the audit-based correction is 0.2-1.8 points. Those figures are WEB widgets; on native Android widgets the recorded scope correction is ~1\%, so on AC-v2 the grading artifact is small. Also: crediting equivalent clicks in a 3B GRPO reward gives no stable gain over box rewards across three seeds and four test sets. NOTE (scope): AGENTS.md/HANDOFF carry the ~1\% native-Android figure as our own scope correction, not this paper's headline.}
}
